static void fmt_hex(char *dst, uint8_t v)
{
    uint8_t i, nib;
    dst[0] = '0'; dst[1] = 'x';
    for (i = 0U; i < 2U; i++) {
        nib = (uint8_t)((v >> ((1U - i) * 4U)) & 0x0FU);
        dst[2U + i] = (char)((nib < 10U) ? ('0' + nib) : ('A' + nib - 10U));
    }
    dst[4] = '\0';
}


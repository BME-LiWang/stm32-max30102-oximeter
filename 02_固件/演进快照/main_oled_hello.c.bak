static void delay_ms(uint32_t ms)
{
    SYSTICK_LOAD = 7999U;
    SYSTICK_VAL  = 0U;
    SYSTICK_CTRL = 0x00000005U;
    while (ms--) {
        while ((SYSTICK_CTRL & (1U << 16)) == 0U) { }
    }
    SYSTICK_CTRL = 0U;
}

static void i2c_init(void)
{
    RCC_APB1ENR |= (1U << 21);
    RCC_APB2ENR |= (1U << 0) | (1U << 3);

    GPIOB_CRL &= ~(0xFFU << 24);
    GPIOB_CRL |=  (0xFFU << 24);        /* PB6/PB7 = 复用开漏 50MHz */

    I2C1_CR1   = 0U;
    I2C1_CR2   = 8U;                   /* APB1 = 8 MHz */
    I2C1_CCR   = 40U;                  /* 8MHz/(2*100kHz) */
    I2C1_TRISE = 9U;
    I2C1_CR1   = (1U << 0);            /* PE */
}

/* 返回 0 成功；1 START 超时；2 地址 NACK；3 数据阶段卡住 */
static uint8_t i2c_tx(uint8_t addr, const uint8_t *buf, uint16_t n)
{
    uint32_t guard;
    uint16_t i;

    I2C1_CR1 |= (1U << 8);             /* START */
    guard = 0U;
    while ((I2C1_SR1 & (1U << 0)) == 0U) {
        if (++guard > 200000U) { I2C1_CR1 |= (1U << 9); return 1U; }
    }

    I2C1_DR = addr;
    guard = 0U;
    while ((I2C1_SR1 & (1U << 1)) == 0U) {
        if (I2C1_SR1 & (1U << 10)) {
            I2C1_SR1 &= ~(1U << 10);
            I2C1_CR1 |= (1U << 9);
            return 2U;
        }
        if (++guard > 200000U) { I2C1_CR1 |= (1U << 9); return 2U; }
    }
    (void)I2C1_SR1; (void)I2C1_SR2;

    for (i = 0U; i < n; i++) {
        guard = 0U;
        while ((I2C1_SR1 & (1U << 7)) == 0U) {
            if (I2C1_SR1 & (1U << 10)) {
                I2C1_SR1 &= ~(1U << 10);
                I2C1_CR1 |= (1U << 9);
                return 3U;
            }
            if (++guard > 200000U) { I2C1_CR1 |= (1U << 9); return 3U; }
        }
        I2C1_DR = buf[i];
    }

    guard = 0U;
    while ((I2C1_SR1 & (1U << 2)) == 0U) {
        if (++guard > 200000U) { I2C1_CR1 |= (1U << 9); return 3U; }
    }
    I2C1_CR1 |= (1U << 9);             /* STOP */

    guard = 0U;
    while (I2C1_SR2 & (1U << 1)) {
        if (++guard > 100000U) break;
    }
    return 0U;
}

static const uint8_t init_seq[] = {
    0x00,
    0xAE, 0xD5, 0x80, 0xA8, 0x3F, 0xD3, 0x00, 0x40,
    0xA0, 0xC0, 0xDA, 0x12, 0x81, 0xCF, 0xD9, 0xF1,
    0xDB, 0x30, 0xA4, 0xA6, 0x8D, 0x14, 0xAF
};

static void fill_screen(uint8_t v)
{
    uint8_t p, x;
    for (p = 0U; p < 8U; p++)
        for (x = 0U; x < 128U; x++) oled_buf[p][x] = v;
}

static void draw_char(uint16_t x, uint8_t page, char c)
{
    const uint8_t *p;
    uint8_t k;
    if (c < 0x20 || c > 0x7E) c = '?';
    p = F8x16[(uint8_t)c - 0x20U];
    for (k = 0U; k < 8U; k++) {
        if ((x + k) < 128U) {
            oled_buf[page][x + k] = p[k];
            oled_buf[page + 1U][x + k] = p[8U + k];
        }
    }
}

static void draw_str(uint16_t x, uint8_t page, const char *s)
{
    while (*s != '\0') {
        if (x > 119U) break;
        draw_char(x, page, *s);
        x += 8U;
        s++;
    }
}

static uint8_t oled_flush(uint8_t addr)
{
    uint8_t d[133];
    uint8_t c[4];
    uint8_t page, i;

    for (page = 0U; page < 8U; page++) {
        c[0] = 0x00U;
        c[1] = (uint8_t)(0xB0U | page);
        c[2] = 0x02U;                           /* SH1106：可见区从第 2 列开始 */
        c[3] = 0x10U;
        if (i2c_tx(addr, c, 4U) != 0U) return 1U;

        d[0] = 0x40U;
        for (i = 0U; i < 132U; i++)
            d[1U + i] = (i < 128U) ? oled_buf[page][i] : 0x00U;
        if (i2c_tx(addr, d, 133U) != 0U) return 2U;
    }
    return 0U;
}

static void blink_fail(uint8_t code)
{
    while (1) {
        if (code == 1U) {                       /* START 不发出 */
            LED_ON();  delay_ms(2000U);
            LED_OFF(); delay_ms(1000U);
        } else if (code == 2U) {                /* 地址无 ACK */
            LED_ON();  delay_ms(150U); LED_OFF(); delay_ms(150U);
            LED_ON();  delay_ms(150U); LED_OFF(); delay_ms(1500U);
        } else {                                /* 数据阶段卡住 */
            LED_ON();  delay_ms(120U); LED_OFF(); delay_ms(120U);
            LED_ON();  delay_ms(120U); LED_OFF(); delay_ms(120U);
            LED_ON();  delay_ms(120U); LED_OFF(); delay_ms(1500U);
        }
    }
}

/* 烧录时刻的电脑时间，作为走时起点 */
static const uint32_t BOOT_SEC = 41605U;
static const char BOOT_DATE[] = "2026-11-11";

int main(void)
{
    uint8_t r;
    uint8_t addr = 0x78U;
    uint32_t sec;
    char tb[9];

    RCC_APB2ENR |= (1U << 0) | (1U << 3) | (1U << 4);
    GPIOC_CRH = (GPIOC_CRH & ~(0xFUL << 20)) | (0x2UL << 20);
    LED_OFF();

    delay_ms(600U);
    i2c_init();

    r = i2c_tx(addr, init_seq, (uint16_t)sizeof(init_seq));
    if (r == 2U) {
        addr = 0x7AU;
        delay_ms(20U);
        r = i2c_tx(addr, init_seq, (uint16_t)sizeof(init_seq));
    }
    if (r != 0U) blink_fail(r);

    /* 自检：全白 -> 全黑 */
    fill_screen(0xFFU); oled_flush(addr); delay_ms(400U);
    fill_screen(0x00U); oled_flush(addr); delay_ms(300U);

    sec = BOOT_SEC;

    while (1) {
        uint32_t h = (sec / 3600U) % 24U;
        uint32_t m = (sec / 60U) % 60U;
        uint32_t s = sec % 60U;

        tb[0] = (char)('0' + (h / 10U));
        tb[1] = (char)('0' + (h % 10U));
        tb[2] = ':';
        tb[3] = (char)('0' + (m / 10U));
        tb[4] = (char)('0' + (m % 10U));
        tb[5] = ':';
        tb[6] = (char)('0' + (s / 10U));
        tb[7] = (char)('0' + (s % 10U));
        tb[8] = '\0';

        fill_screen(0x00U);
        draw_str(16U, 0U, "Hello STM32!");
        draw_str(24U, 2U, BOOT_DATE);
        draw_str(32U, 4U, tb);
        draw_str(12U, 6U, "OLED 0.96 I2C");

        if (oled_flush(addr) != 0U) blink_fail(3U);

        LED_ON();  delay_ms(20U);
        LED_OFF(); delay_ms(870U);

        sec++;
        if (sec >= 86400U) sec = 0U;
    }
}
